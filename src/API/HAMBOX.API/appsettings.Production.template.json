{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "SET_VIA_MONSTERASP_OR_ENV"
  },
  "JwtSettings": {
    "Issuer": "HamboxAuth",
    "Audience": "HamboxWebAPI",
    "SecretKey": "SET_VIA_ENV_MIN_32_CHARS",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://hambox.vercel.app"
    ]
  },
  "EmailSettings": {
    "Enabled": false,
    "ApplicationBaseUrl": "https://hambox.vercel.app"
  }
}
