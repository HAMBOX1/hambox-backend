# Copy to .env (never commit .env). Values below are placeholders.
# Read by docker-compose.yml and by /opt/hambox/scripts/backup-db.sh on the server.

# SQL Server `sa` password (also used by the backup script).
SA_PASSWORD=ChangeMe-Strong-Password-1!

# Database name.
DB_NAME=HamboxDb

# Development | Production
ASPNETCORE_ENVIRONMENT=Development

# JWT signing key, at least 32 characters. Mapped to JwtSettings__SecretKey.
JWT_SECRET_KEY=ChangeMe-AtLeast-32-Characters-Long-Random-Key

# ---------------------------------------------------------------------------
# Production-only values live in /opt/hambox/appsettings.Production.json (not .env):
#   Encryption:*                      key material for stored codes — back it up separately
#   EmailSettings:*                   SMTP host / user / password / sender
#   Monitoring:WatchdogToken          shared secret for GET /api/v1/system/worker-health
#   Monitoring:AlertEmails            addresses that receive critical operational alerts
#   SupplierRateLimits:*              fallback throttle (editable in Settings → Retry policies)
#   Payment gateway credentials       stored encrypted via Admin → Payment gateways, not in files
# ---------------------------------------------------------------------------
